{
  "name": "voxie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p functions && tsc -p tsconfig.test.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "pages": "npm run build && wrangler pages dev dist --compatibility-date=2026-05-26",
    "content:audit": "esbuild scripts/content-audit.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/content-audit.mjs --log-level=warning && node node_modules/.cache/content-audit.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "dompurify": "^3.3.1",
    "framer-motion": "^12.34.0",
    "i18next": "^25.8.4",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0"
  }
}
